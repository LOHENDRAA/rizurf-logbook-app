APP_NAME="Rizurf Logbook"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Production/compose example: DB_HOST=db DB_DATABASE=logbook
# DB_USERNAME=logbook DB_PASSWORD=secret (MariaDB service).
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=logbook
DB_USERNAME=logbook
DB_PASSWORD=
# Local socket auth alternative (no username/password):
# DB_HOST=localhost
# DB_SOCKET=/run/mysqld/mysqld.sock

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS, same-site SPA): true / true / lax
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Comma-separated SPA origins allowed to call the API with credentials.
FRONTEND_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Rate limits (requests per minute).
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=120

# Hours an Idempotency-Key response is replayed.
IDEMPOTENCY_TTL_HOURS=24

# Seeded demo password (local/dev seeders only; seeding is blocked in production).
DEMO_PASSWORD=change-me-in-dev-only
