{
  "openapi": "3.0.3",
  "info": {
    "title": "Intern Logbook",
    "version": "1.0.0",
    "description": "Interns keep a daily notepad and fill in their university's weekly logbook; supervisors review, approve and export it.",
    "x-rizurf": {
      "domain": "Human Resources",
      "owner": "intern-logbook-team",
      "category": "Documents",
      "industries": [
        "Human Resources"
      ],
      "use_cases": [
        "Interns logging what they did each day of an internship",
        "Filling in a university's weekly logbook form",
        "Supervisors approving or returning weekly logbooks",
        "Exporting a finished logbook for the university"
      ],
      "capabilities": [
        {
          "name": "Keep a Logbook",
          "icon": "📓",
          "description": "Everything an intern does: set up, write notes, fill in weeks and submit them.",
          "does": [
            "Set up an internship",
            "Write daily notes",
            "Fill in a week's form",
            "Submit a week"
          ],
          "best_for": "Intern-facing screens.",
          "endpoints": [
            "GET /me",
            "GET /me/internship",
            "PUT /me/internship",
            "GET /me/logbook",
            "GET /me/template",
            "GET /me/journal/weeks",
            "GET /me/journal/weeks/{weekNumber}",
            "PUT /me/journal/weeks/{weekNumber}/daily",
            "PUT /me/journal/weeks/{weekNumber}/values",
            "POST /me/journal/weeks/{weekNumber}/submit"
          ]
        },
        {
          "name": "Review Interns",
          "icon": "✅",
          "description": "Supervisors read their interns' logbooks and approve or return weeks.",
          "does": [
            "List interns",
            "Read an intern's logbook",
            "Approve a week",
            "Send a week back with feedback"
          ],
          "best_for": "Supervisor screens and review dashboards.",
          "endpoints": [
            "GET /supervisor/interns",
            "GET /supervisor/interns/{studentId}/weeks",
            "GET /supervisor/interns/{studentId}/logbook",
            "GET /supervisor/interns/{studentId}/weeks/{weekNumber}",
            "POST /supervisor/interns/{studentId}/weeks/{weekNumber}/review"
          ]
        },
        {
          "name": "Manage Templates",
          "icon": "🗂️",
          "description": "Upload and maintain each university's logbook template.",
          "does": [
            "Upload a university template",
            "Edit its placeholders",
            "Download the original file",
            "Delete a template"
          ],
          "best_for": "Supervisors preparing logbooks for a new university.",
          "endpoints": [
            "GET /templates",
            "POST /templates",
            "GET /templates/{id}",
            "PUT /templates/{id}",
            "DELETE /templates/{id}",
            "GET /templates/{id}/file"
          ]
        },
        {
          "name": "Sign In",
          "icon": "🔑",
          "description": "Sign-in through the Rizurf gateway; the logbook stores no passwords.",
          "does": [
            "Send someone to the gateway to sign in",
            "Start a session from the gateway's code"
          ],
          "best_for": "The logbook's own screens.",
          "endpoints": [
            "GET /auth/sign-in",
            "POST /auth/gateway"
          ]
        },
        {
          "name": "Service Status",
          "icon": "🩺",
          "description": "Whether the logbook is up, and what its API can do.",
          "does": [
            "Check the service is up",
            "Read the API description"
          ],
          "best_for": "Monitoring and the gateway catalogue.",
          "endpoints": [
            "GET /health",
            "GET /openapi.json"
          ]
        }
      ],
      "workflows": [
        {
          "name": "An intern's week",
          "steps": [
            "PUT /me/internship",
            "PUT /me/journal/weeks/{weekNumber}/daily",
            "PUT /me/journal/weeks/{weekNumber}/values",
            "POST /me/journal/weeks/{weekNumber}/submit"
          ]
        },
        {
          "name": "Supervisor review",
          "steps": [
            "GET /supervisor/interns",
            "GET /supervisor/interns/{studentId}/logbook",
            "POST /supervisor/interns/{studentId}/weeks/{weekNumber}/review"
          ]
        }
      ],
      "related_services": []
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "rizurf_logbook_session",
        "description": "The logbook's own signed-in session, started from a verified gateway identity token (POST /auth/gateway)."
      }
    }
  },
  "security": [
    {
      "sessionCookie": []
    }
