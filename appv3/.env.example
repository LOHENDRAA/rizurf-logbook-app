# Monorepo compose configuration. Copy to .env and adjust secrets.
# Only the host port is configurable here; the stack always serves
# the SPA + API on the same origin (no CORS needed).

# Host port mapped to nginx :80 (port 8000 is commonly occupied locally).
APP_PORT=8080

# Public origin of the stack (used for absolute URLs only).
APP_URL=http://localhost:8080

# Laravel app key. Generate one and paste it here for stable sessions:
#   docker compose run --rm app php artisan key:generate --show
# When left empty the app container generates an ephemeral key on boot.
APP_KEY=

# MariaDB database + credentials (shared by the app and db services).
DB_DATABASE=logbook
DB_USER=logbook
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Same-origin deploy: leave empty. Only needed when the SPA is served
# from a different origin than the API.
FRONTEND_ORIGINS=
SANCTUM_STATEFUL_DOMAINS=

# Rate limits (requests per minute) and idempotency replay horizon (hours).
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=120
IDEMPOTENCY_TTL_HOURS=24
