# Added during RizurfV2 handoff (2026-09-23). Source v3 had no root .gitignore;
# backend/.gitignore is untouched (it already covers vendor, *.log, .env, etc).
# Patterns below apply repo-wide from this root.
node_modules/
dist/
vendor/
*.tsbuildinfo
.env
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/framework/testing/*
!backend/storage/framework/**/.gitignore
backend/bootstrap/cache/*.php
.phpunit.result.cache
database.sqlite
