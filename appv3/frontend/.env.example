# Copy to .env and adjust per environment. Never commit secrets.
# Same-origin default: empty means the SPA calls /api/v1 on its own origin
# (required for the HttpOnly Secure same-site cookie session).
VITE_API_BASE_URL=
# development | test | staging | production
VITE_APP_ENV=development
# Mock Service Worker: dev/test only. Production builds fail closed when true.
VITE_ENABLE_MSW=false
