{
  "name": "rizurf-logbook-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "openapi:types": "openapi-typescript openapi/portal.yaml -o src/api/generated.d.ts",
    "openapi:lint": "node scripts/openapi-lint.mjs",
    "openapi:drift": "openapi-typescript openapi/portal.yaml -o /tmp/opencode/portal-generated-check.d.ts && diff -q /tmp/opencode/portal-generated-check.d.ts src/api/generated.d.ts && node scripts/openapi-lint.mjs",
    "bundle:check": "node scripts/check-prod-bundle.mjs",
    "test:review:stress": "node scripts/stress-managed-review.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
